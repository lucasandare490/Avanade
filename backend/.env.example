# Compose reads this after copying to .env. Set distinct local values (never commit).
MIGRATION_PASSWORD=
DATABASE_PASSWORD=
# Used only to create new demo accounts; does not reset existing passwords.
DEMO_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Running the jar outside Compose (export explicitly; Spring does not load .env):
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/split
DATABASE_USER=split_app
MIGRATION_USER=split_owner
SERVER_ADDRESS=127.0.0.1
PORT=8080
API_DOCS_ENABLED=false
