{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "hospedagem-vercel",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "https://planner-api-tvmg.onrender.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://planner-api-tvmg.onrender.com/:path*",
      "permanent": true
    }
  ]
}
