# Copiar para backend/.env.supabase (ignorado pelo Git).
# Este arquivo é carregado pelo Bash: use aspas simples nos valores.
# Copie o host exato de Connect > Session pooler; não deduza pela região.
DATABASE_URL='jdbc:postgresql://HOST_DO_SESSION_POOLER:5432/postgres'
DATABASE_USER='split_app.PROJECT_REF'
DATABASE_PASSWORD=''
MIGRATION_URL='jdbc:postgresql://HOST_DO_SESSION_POOLER:5432/postgres'
MIGRATION_USER='split_owner.PROJECT_REF'
MIGRATION_PASSWORD=''
# Baixe o certificado CA nas configurações do banco e informe caminho absoluto.
SUPABASE_SSL_ROOT_CERT='/caminho/absoluto/prod-supabase.cer'
DATABASE_POOL_SIZE=3
SERVER_ADDRESS=127.0.0.1
PORT=8080
CORS_ORIGINS='http://127.0.0.1:5173,http://localhost:5173'
API_DOCS_ENABLED=false
DEMO_SEED_ENABLED=false
